{
  "rewrites": [
    {
      "source": "/tra-cuu-bao-hanh",
      "destination": "/tra-cuu-bao-hanh.html"
    },
    {
      "source": "/products/(.*)",
      "destination": "/api/legacy-product?path=$1"
    },
    {
      "source": "/c/(.*)",
      "destination": "/api/legacy-product?path=$1"
    },
    {
      "source": "/dien-thoai",
      "destination": "/"
    },
    {
      "source": "/may-tinh-bang",
      "destination": "/"
    },
    {
      "source": "/may-cu",
      "destination": "/"
    },
    {
      "source": "/phu-kien",
      "destination": "/"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/admin",
      "destination": "/admin-specs.html"
    },
    {
      "source": "/order-may",
      "destination": "/order-may.html"
    },
    {
      "source": "/admin-specs",
      "destination": "/admin-redirect.html"
    },
    {
      "source": "/san-pham/(.*)",
      "destination": "/api/product-page?slug=$1"
    },
    {
      "source": "/thong-tin-phap-ly",
      "destination": "/thong-tin-phap-ly.html"
    },
    {
      "source": "/chinh-sach-bao-mat",
      "destination": "/chinh-sach-bao-mat.html"
    },
    {
      "source": "/chinh-sach-thanh-toan",
      "destination": "/chinh-sach-thanh-toan.html"
    },
    {
      "source": "/chinh-sach-doi-tra",
      "destination": "/chinh-sach-doi-tra.html"
    },
    {
      "source": "/chinh-sach-van-chuyen",
      "destination": "/chinh-sach-van-chuyen.html"
    },
    {
      "source": "/",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/admin-specs.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/api/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/warranty-lookup",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/admin/analytics",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosn"
        }
      ]
    },
    {
      "source": "/tra-cuu-bao-hanh(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/admin/warranty-history",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/admin-login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/admin-session",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/admin-logout",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
